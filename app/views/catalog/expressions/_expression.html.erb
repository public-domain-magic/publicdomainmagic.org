<div id="<%= dom_id expression %>">
  <div>
    <strong>Title:</strong>
    <%= expression.title %>
  </div>

  <div>
    <strong>Date:</strong>
    <%= expression.date %>
  </div>

  <div>
    <strong>Identifier:</strong>
    <%= expression.identifier %>
  </div>

  <div>
    <strong>Summary:</strong>
    <%= expression.summary %>
  </div>

  <div>
    <strong>Form of expression:</strong>
    <%= expression.form_of_expression_id %>
  </div>

  <div>
    <strong>Language:</strong>
    <%= expression.language_id %>
  </div>

  <div>
    <strong>Work:</strong>
    <%= expression.work_id %>
  </div>

</div>
