<div id="<%= dom_id manifestation %>">
  <div>
    <strong>Title:</strong>
    <%= manifestation.title %>
  </div>

  <div>
    <strong>Statement of responsibility:</strong>
    <%= manifestation.statement_of_responsibility %>
  </div>

  <div>
    <strong>Edition or issue:</strong>
    <%= manifestation.edition_or_issue %>
  </div>

  <div>
    <strong>Date of publication:</strong>
    <%= manifestation.date_of_publication %>
  </div>

  <div>
    <strong>Form of expression:</strong>
    <%= manifestation.form_of_expression_id %>
  </div>

  <div>
    <strong>Medium:</strong>
    <%= manifestation.medium_id %>
  </div>

  <div>
    <strong>Language:</strong>
    <%= manifestation.language_id %>
  </div>

  <div>
    <strong>Series:</strong>
    <%= manifestation.series_id %>
  </div>

  <div>
    <strong>Expression:</strong>
    <%= manifestation.expression_id %>
  </div>

</div>
