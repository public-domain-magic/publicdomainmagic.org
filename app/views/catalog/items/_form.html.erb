<%= form_with(model: catalog_item) do |form| %>
  <% if catalog_item.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(catalog_item.errors.count, "error") %> prohibited this catalog_item from being saved:</h2>

      <ul>
        <% catalog_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :identifier, style: "display: block" %>
    <%= form.text_field :identifier %>
  </div>

  <div>
    <%= form.label :provenance, style: "display: block" %>
    <%= form.text_field :provenance %>
  </div>

  <div>
    <%= form.label :marks, style: "display: block" %>
    <%= form.text_field :marks %>
  </div>

  <div>
    <%= form.label :manifestation_id, style: "display: block" %>
    <%= form.text_field :manifestation_id %>
  </div>

  <div>
    <%= form.label :condition_id, style: "display: block" %>
    <%= form.text_field :condition_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
