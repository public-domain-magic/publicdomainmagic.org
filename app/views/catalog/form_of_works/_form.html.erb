<%= form_with(model: catalog_form_of_work) do |form| %>
  <% if catalog_form_of_work.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(catalog_form_of_work.errors.count, "error") %> prohibited this catalog_form_of_work from being saved:</h2>

      <ul>
        <% catalog_form_of_work.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
