<p style="color: green"><%= notice %></p>

<% content_for :title, "Conditions" %>

<h1>Conditions</h1>

<div id="catalog_conditions">
  <% @catalog_conditions.each do |catalog_condition| %>
    <%= render catalog_condition %>
    <p>
      <%= link_to "Show this condition", catalog_condition %>
    </p>
  <% end %>
</div>

<%= link_to "New condition", new_catalog_condition_path %>
