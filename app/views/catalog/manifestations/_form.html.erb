<%= form_with(model: catalog_manifestation) do |form| %>
  <% if catalog_manifestation.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(catalog_manifestation.errors.count, "error") %> prohibited this catalog_manifestation from being saved:</h2>

      <ul>
        <% catalog_manifestation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :statement_of_responsibility, style: "display: block" %>
    <%= form.text_field :statement_of_responsibility %>
  </div>

  <div>
    <%= form.label :edition_or_issue, style: "display: block" %>
    <%= form.text_field :edition_or_issue %>
  </div>

  <div>
    <%= form.label :date_of_publication, style: "display: block" %>
    <%= form.date_field :date_of_publication %>
  </div>

  <div>
    <%= form.label :place_of_publication, style: "display: block" %>
    <%= form.text_field :place_of_publication %>
  </div>

  <div>
    <%= form.label :identifier, style: "display: block" %>
    <%= form.text_field :identifier %>
  </div>

  <div>
    <%= form.label :carrier_id, style: "display: block" %>
    <%= form.text_field :carrier_id %>
  </div>

  <div>
    <%= form.label :series_id, style: "display: block" %>
    <%= form.text_field :series_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
