<% content_for :page_title, "Record a discovery" %>

<p>
  Record a book you have found, with whatever is known. This clarifies whether it
  could be public domain and states, for everyone, that it exists. You can deepen
  the record later.
</p>

<%= form_with model: @discovery do |form| %>
  <% if @discovery.errors.any? %>
    <section aria-labelledby="errors-heading">
      <h2 id="errors-heading"><%= pluralize(@discovery.errors.count, "problem") %> kept this from being saved</h2>
      <ul>
        <% @discovery.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <fieldset>
    <legend>The book</legend>

    <p>
      <%= form.label :title, "Title" %><br>
      <%= form.text_field :title, required: true, autofocus: true %>
    </p>
    <p>
      <%= form.label :date, "Approximate date of the work" %><br>
      <%= form.text_field :date, placeholder: "e.g. 1902 or 1924/1928" %>
    </p>
    <p>
      <%= form.label :form_of_work_id, "Form of work (optional)" %><br>
      <%= form.collection_select :form_of_work_id, Catalog::FormOfWork.order(:name), :id, :name, include_blank: "Unknown for now" %>
    </p>
  </fieldset>

  <fieldset>
    <legend>Authors</legend>
    <p>One name per box; leave the rest blank. Pseudonyms and unknown names are fine.</p>
    <% 3.times do |index| %>
      <p>
        <%= label_tag "discovery_author_names_#{index}", "Author #{index + 1}" %><br>
        <%= text_field_tag "discovery[author_names][]", @discovery.author_names[index], id: "discovery_author_names_#{index}" %>
      </p>
    <% end %>
  </fieldset>

  <fieldset>
    <legend>Copyright</legend>
    <p>
      <%= form.label :first_publication_year, "First publication year" %><br>
      <%= form.text_field :first_publication_year, placeholder: "A pre-1978 year computes the public-domain countdown" %>
    </p>
    <p>
      <%= form.label :first_publication_country, "First publication country" %><br>
      <%= form.text_field :first_publication_country %>
    </p>
  </fieldset>

  <fieldset>
    <legend>Copies found online</legend>
    <p>Each copy read online is an edition. Attach it to the same text unless its content was changed.</p>
    <%= form.fields_for :found_copies do |copy| %>
      <fieldset>
        <p>
          <%= copy.label :url, "URL" %><br>
          <%= copy.url_field :url %>
        </p>
        <p>
          <%= copy.label :source, "Source (e.g. Internet Archive)" %><br>
          <%= copy.text_field :source %>
        </p>
        <p>
          <%= copy.label :statement_of_responsibility, "Byline as printed" %><br>
          <%= copy.text_field :statement_of_responsibility %>
        </p>
        <p>
          <%= copy.label :content, "This copy's text" %><br>
          <%= copy.select :content, [["is the same as the original", "same"], ["was changed (modernized, abridged, annotated)", "new"]] %>
        </p>
      </fieldset>
    <% end %>
  </fieldset>

  <fieldset>
    <legend>Records about the book</legend>
    <p>Third-party records that attest the book exists — Conjuring Archive, Magicpedia, a dealer page.</p>
    <%= form.fields_for :external_references do |reference| %>
      <fieldset>
        <p>
          <%= reference.label :url, "URL" %><br>
          <%= reference.url_field :url %>
        </p>
        <p>
          <%= reference.label :source, "Source" %><br>
          <%= reference.text_field :source %>
        </p>
        <p>
          <%= reference.label :note, "Note" %><br>
          <%= reference.text_field :note %>
        </p>
      </fieldset>
    <% end %>
  </fieldset>

  <fieldset>
    <legend>Publishing</legend>
    <p>
      <%= form.label :exposure, "Exposure" %><br>
      <%= form.select :exposure, [["Public — open to everyone", "public"], ["Protected — magic community only", "protected"]] %>
    </p>
    <p>
      <%= form.label :notes, "Private note (optional)" %><br>
      <%= form.text_area :notes, rows: 3 %>
    </p>
  </fieldset>

  <p><%= form.submit "Record this discovery" %></p>
<% end %>
