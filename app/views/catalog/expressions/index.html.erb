<p style="color: green"><%= notice %></p>

<% content_for :title, "Expressions" %>

<h1>Expressions</h1>

<div id="catalog_expressions">
  <% @catalog_expressions.each do |catalog_expression| %>
    <%= render catalog_expression %>
    <p>
      <%= link_to "Show this expression", catalog_expression %>
    </p>
  <% end %>
</div>

<%= link_to "New expression", new_catalog_expression_path %>
