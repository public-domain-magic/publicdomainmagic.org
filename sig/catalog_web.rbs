# Hand-written signatures for the Catalog scaffold web layer (controllers and
# helpers). The action methods return `void` because Rails ignores their return
# value; the request/response plumbing comes from ::ActionController::Base and
# the route helpers from the generated ::_RbsRailsPathHelpers interface.

class Catalog::CarriersController < ::ApplicationController
  def index: () -> void
  def show: () -> void
  def new: () -> void
  def edit: () -> void
  def create: () -> void
  def update: () -> void
  def destroy: () -> void

  private

  def set_catalog_carrier: () -> void
  def catalog_carrier_params: () -> ::ActionController::Parameters
end

