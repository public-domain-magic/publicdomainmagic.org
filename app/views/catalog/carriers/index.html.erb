<p style="color: green"><%= notice %></p>

<% content_for :title, "Carriers" %>

<h1>Carriers</h1>

<div id="catalog_carriers">
  <% @catalog_carriers.each do |catalog_carrier| %>
    <%= render catalog_carrier %>
    <p>
      <%= link_to "Show this carrier", catalog_carrier %>
    </p>
  <% end %>
</div>

<%= link_to "New carrier", new_catalog_carrier_path %>
